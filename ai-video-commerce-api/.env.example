# Database connection (development example only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ai_video_user
DB_PASSWORD=replace-with-local-password
DB_NAME=ai_video_commerce

# Generate a unique high-entropy value for every deployed environment.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_HOURS=2

APP_ENV=development

# Safe defaults: application startup does not modify the database.
AUTO_CREATE_SCHEMA=false
SEED_ADMIN=false
SEED_SYSTEM_SETTINGS=false

# Required only when SEED_ADMIN=true in a non-production environment.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
