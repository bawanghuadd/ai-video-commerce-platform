<script setup>
import {
  computed,
  nextTick,
  onMounted,
  reactive,
  ref,
} from 'vue'

import { ElMessage } from 'element-plus'

import {
  Collection,
  Delete,
  Edit,
  Link,
  Plus,
  Reading,
  Refresh,
  Search,
  Star,
  View,
} from '@element-plus/icons-vue'

import AppStatCard from '../components/common/AppStatCard.vue'

import {
  createKnowledgeApi,
  deleteKnowledgeApi,
  getKnowledgeListApi,
  recordKnowledgeUsageApi,
  updateKnowledgeApi,
} from '../api/knowledge.js'

import {
  getProductListApi,
} from '../api/products.js'

import {
  useAsyncList,
} from '../composables/useAsyncList.js'

import {
  usePagination,
} from '../composables/usePagination.js'

import {
  getApiErrorMessage,
} from '../utils/apiResponse.js'

import {
  formatDateTime,
} from '../utils/date.js'

import {
  confirmDelete,
} from '../utils/confirm.js'


/* ==============================
   页面状态
================================ */

const submitting = ref(false)
const usingKnowledgeId = ref(null)

const dialogVisible = ref(false)
const dialogMode = ref('create')
const editingKnowledgeId = ref(null)
const formRef = ref(null)

const detailVisible = ref(false)
const selectedKnowledge = ref(null)


/* ==============================
   数据列表
================================ */

const {
  list: knowledgeList,
  loading,
  load: requestKnowledgeList,
} = useAsyncList(
  getKnowledgeListApi,
  {
    errorMessage: '知识库加载失败',
  },
)

const {
  list: productList,
  load: requestProductList,
} = useAsyncList(
  getProductListApi,
  {
    errorMessage: '商品列表加载失败',
  },
)


/* ==============================
   分页
================================ */

const {
  currentPage,
  pageSize,
  total: totalRecords,
  pageList: paginatedKnowledgeList,
  resetPage,
  changePageSize,
} = usePagination(
  knowledgeList,
  8,
)


/* ==============================
   查询条件
================================ */

const filterForm = reactive({
  keyword: '',
  category: '',
  status: '',
  product_id: null,
  is_featured: null,
})

const appliedFilters = reactive({
  keyword: '',
  category: '',
  status: '',
  product_id: null,
  is_featured: null,
})


/* ==============================
   表单数据
================================ */

const knowledgeForm = reactive({
  product_id: null,
  title: '',
  category: '爆款开场钩子',
  summary: '',
  content: '',
  tags: [],
  source_type: '手动录入',
  source_id: null,
  status: '草稿',
  is_featured: false,
  usage_count: 0,
  created_by: '系统管理员',
})


/* ==============================
   表单校验
================================ */

const formRules = {
  title: [
    {
      required: true,
      message: '请输入知识标题',
      trigger: 'blur',
    },
    {
      min: 1,
      max: 200,
      message: '知识标题长度为1到200个字符',
      trigger: 'blur',
    },
  ],

  category: [
    {
      required: true,
      message: '请选择知识分类',
      trigger: 'change',
    },
  ],

  content: [
    {
      required: true,
      message: '请输入知识正文',
      trigger: 'blur',
    },
  ],

  status: [
    {
      required: true,
      message: '请选择知识状态',
      trigger: 'change',
    },
  ],

  created_by: [
    {
      required: true,
      message: '请输入创建人',
      trigger: 'blur',
    },
  ],
}


/* ==============================
   固定选项
================================ */

const categoryOptions = [
  '爆款开场钩子',
  '高转化脚本',
  '商品卖点模板',
  'AI提示词',
  '投流复盘经验',
  '失败案例',
  '视频制作规范',
]

const statusOptions = [
  '草稿',
  '已发布',
  '已归档',
]

const sourceTypeOptions = [
  '手动录入',
  '内容拆解',
  '脚本分镜',
  '视频任务',
  '投流复盘',
  'AI自动沉淀',
]


/* ==============================
   计算属性
================================ */

const dialogTitle = computed(() => {
  return dialogMode.value === 'create'
    ? '新增知识'
    : '编辑知识'
})

const publishedCount = computed(() => {
  return knowledgeList.value.filter(
    (item) => item.status === '已发布',
  ).length
})

const featuredCount = computed(() => {
  return knowledgeList.value.filter(
    (item) => Boolean(item.is_featured),
  ).length
})

const totalUsageCount = computed(() => {
  return knowledgeList.value.reduce(
    (total, item) => {
      return total + Number(
        item.usage_count || 0,
      )
    },
    0,
  )
})


/* ==============================
   工具函数
================================ */

function getProductName(productId) {
  if (!productId) {
    return '通用知识'
  }

  const product = productList.value.find(
    (item) => {
      return (
        Number(item.id) ===
        Number(productId)
      )
    },
  )

  return (
    product?.product_name ||
    product?.name ||
    `商品 ID：${productId}`
  )
}

function getStatusClass(status) {
  const statusMap = {
    草稿: 'draft',
    已发布: 'published',
    已归档: 'archived',
  }

  return statusMap[status] || 'draft'
}

function getCategoryClass(category) {
  const categoryMap = {
    爆款开场钩子: 'hook',
    高转化脚本: 'script',
    商品卖点模板: 'selling',
    AI提示词: 'prompt',
    投流复盘经验: 'traffic',
    失败案例: 'failure',
    视频制作规范: 'video',
  }

  return categoryMap[category] || 'default'
}

function getStoredUserName() {
  try {
    const user = JSON.parse(
      localStorage.getItem('user') || '{}',
    )

    return (
      user.display_name ||
      user.username ||
      '系统管理员'
    )
  } catch {
    return '系统管理员'
  }
}


/* ==============================
   查询参数
================================ */

function buildKnowledgeQueryParams() {
  const params = {}

  const keyword =
    appliedFilters.keyword.trim()

  if (keyword) {
    params.keyword = keyword
  }

  if (appliedFilters.category) {
    params.category =
      appliedFilters.category
  }

  if (appliedFilters.status) {
    params.status =
      appliedFilters.status
  }

  if (appliedFilters.product_id) {
    params.product_id =
      appliedFilters.product_id
  }

  if (
    appliedFilters.is_featured !== null
  ) {
    params.is_featured =
      appliedFilters.is_featured
  }

  return params
}


/* ==============================
   加载数据
================================ */

async function loadKnowledgeList() {
  const params =
    buildKnowledgeQueryParams()

  try {
    await requestKnowledgeList(params)
  } catch {
    // useAsyncList 已经统一显示错误消息。
  }
}

async function loadProducts() {
  try {
    await requestProductList()
  } catch {
    // useAsyncList 已经统一显示错误消息。
  }
}


/* ==============================
   查询与重置
================================ */

async function handleSearch() {
  Object.assign(appliedFilters, {
    keyword:
      filterForm.keyword,

    category:
      filterForm.category,

    status:
      filterForm.status,

    product_id:
      filterForm.product_id,

    is_featured:
      filterForm.is_featured,
  })

  resetPage()

  await loadKnowledgeList()
}

async function handleReset() {
  Object.assign(filterForm, {
    keyword: '',
    category: '',
    status: '',
    product_id: null,
    is_featured: null,
  })

  Object.assign(appliedFilters, {
    keyword: '',
    category: '',
    status: '',
    product_id: null,
    is_featured: null,
  })

  resetPage()

  await loadKnowledgeList()
}


/* ==============================
   重置知识表单
================================ */

function resetKnowledgeForm() {
  editingKnowledgeId.value = null

  Object.assign(knowledgeForm, {
    product_id: null,
    title: '',
    category: '爆款开场钩子',
    summary: '',
    content: '',
    tags: [],
    source_type: '手动录入',
    source_id: null,
    status: '草稿',
    is_featured: false,
    usage_count: 0,
    created_by: getStoredUserName(),
  })

  formRef.value?.clearValidate()
}


/* ==============================
   新增知识
================================ */

async function openCreateDialog() {
  dialogMode.value = 'create'

  resetKnowledgeForm()

  dialogVisible.value = true

  await nextTick()

  formRef.value?.clearValidate()
}


/* ==============================
   编辑知识
================================ */

async function openEditDialog(item) {
  dialogMode.value = 'edit'
  editingKnowledgeId.value = item.id

  Object.assign(knowledgeForm, {
    product_id:
      item.product_id ?? null,

    title:
      item.title || '',

    category:
      item.category ||
      '爆款开场钩子',

    summary:
      item.summary || '',

    content:
      item.content || '',

    tags:
      Array.isArray(item.tags)
        ? [...item.tags]
        : [],

    source_type:
      item.source_type ||
      '手动录入',

    source_id:
      item.source_id ?? null,

    status:
      item.status || '草稿',

    is_featured:
      Boolean(item.is_featured),

    usage_count:
      Number(item.usage_count || 0),

    created_by:
      item.created_by ||
      '系统管理员',
  })

  dialogVisible.value = true

  await nextTick()

  formRef.value?.clearValidate()
}


/* ==============================
   提交参数
================================ */

function buildKnowledgeSubmitData() {
  return {
    product_id:
      knowledgeForm.product_id
        ? Number(
            knowledgeForm.product_id,
          )
        : null,

    title:
      knowledgeForm.title.trim(),

    category:
      knowledgeForm.category,

    summary:
      knowledgeForm.summary.trim() ||
      null,

    content:
      knowledgeForm.content.trim(),

    tags:
      knowledgeForm.tags
        .map((tag) => {
          return String(tag).trim()
        })
        .filter(Boolean),

    source_type:
      knowledgeForm.source_type,

    source_id:
      knowledgeForm.source_id
        ? Number(
            knowledgeForm.source_id,
          )
        : null,

    status:
      knowledgeForm.status,

    is_featured:
      Boolean(
        knowledgeForm.is_featured,
      ),

    usage_count:
      Number(
        knowledgeForm.usage_count || 0,
      ),

    created_by:
      knowledgeForm.created_by.trim(),
  }
}


/* ==============================
   保存知识
================================ */

async function submitKnowledge() {
  if (!formRef.value) {
    return
  }

  try {
    await formRef.value.validate()
  } catch {
    return
  }

  submitting.value = true

  const submitData =
    buildKnowledgeSubmitData()

  try {
    if (
      dialogMode.value === 'create'
    ) {
      await createKnowledgeApi(
        submitData,
      )

      ElMessage.success(
        '知识库条目创建成功',
      )
    } else {
      await updateKnowledgeApi(
        editingKnowledgeId.value,
        submitData,
      )

      ElMessage.success(
        '知识库条目修改成功',
      )
    }

    dialogVisible.value = false

    await loadKnowledgeList()
  } catch (error) {
    ElMessage.error(
      getApiErrorMessage(
        error,
        '知识库条目保存失败',
      ),
    )
  } finally {
    submitting.value = false
  }
}


/* ==============================
   查看详情
================================ */

function openKnowledgeDetail(item) {
  selectedKnowledge.value = {
    ...item,
    tags: Array.isArray(item.tags)
      ? [...item.tags]
      : [],
  }

  detailVisible.value = true
}


/* ==============================
   引用知识
================================ */

async function handleUseKnowledge(item) {
  usingKnowledgeId.value = item.id

  try {
    await recordKnowledgeUsageApi(
      item.id,
    )

    ElMessage.success(
      '知识已引用，引用次数已更新',
    )

    await loadKnowledgeList()

    if (
      selectedKnowledge.value?.id ===
      item.id
    ) {
      selectedKnowledge.value = {
        ...selectedKnowledge.value,

        usage_count:
          Number(
            selectedKnowledge.value
              .usage_count || 0,
          ) + 1,
      }
    }
  } catch (error) {
    ElMessage.error(
      getApiErrorMessage(
        error,
        '知识引用失败',
      ),
    )
  } finally {
    usingKnowledgeId.value = null
  }
}


/* ==============================
   删除知识
================================ */

async function handleDelete(item) {
  const confirmed =
    await confirmDelete(
      item.title,
      {
        title: '删除知识库条目',
      },
    )

  if (!confirmed) {
    return
  }

  try {
    await deleteKnowledgeApi(item.id)

    if (
      selectedKnowledge.value?.id ===
      item.id
    ) {
      detailVisible.value = false
      selectedKnowledge.value = null
    }

    ElMessage.success(
      '知识库条目删除成功',
    )

    await loadKnowledgeList()
  } catch (error) {
    ElMessage.error(
      getApiErrorMessage(
        error,
        '知识库条目删除失败',
      ),
    )
  }
}


/* ==============================
   生命周期
================================ */

onMounted(async () => {
  await Promise.all([
    loadProducts(),
    loadKnowledgeList(),
  ])
})
</script>


<template>
  <div class="knowledge-page">
    <!-- 数据概览 -->
    <section class="summary-grid">
      <AppStatCard
        title="知识总数"
        :value="totalRecords"
        :icon="Collection"
        tone="purple"
      />

      <AppStatCard
        title="已发布"
        :value="publishedCount"
        :icon="Reading"
        tone="green"
      />

      <AppStatCard
        title="精选知识"
        :value="featuredCount"
        :icon="Star"
        tone="orange"
      />

      <AppStatCard
        title="累计引用"
        :value="totalUsageCount"
        :icon="Link"
        tone="cyan"
      />
    </section>

    <section class="knowledge-panel">
      <!-- 筛选栏 -->
      <div class="filter-section">
        <div
          class="filter-control keyword-control"
        >
          <span class="filter-label">
            关键词
          </span>

          <el-input
            v-model="filterForm.keyword"
            clearable
            placeholder="搜索标题、摘要或正文"
            @keyup.enter="handleSearch"
          />
        </div>

        <div class="filter-control">
          <span class="filter-label">
            分类
          </span>

          <el-select
            v-model="filterForm.category"
            clearable
            placeholder="请选择分类"
          >
            <el-option
              v-for="category in categoryOptions"
              :key="category"
              :label="category"
              :value="category"
            />
          </el-select>
        </div>

        <div class="filter-control">
          <span class="filter-label">
            状态
          </span>

          <el-select
            v-model="filterForm.status"
            clearable
            placeholder="请选择状态"
          >
            <el-option
              v-for="status in statusOptions"
              :key="status"
              :label="status"
              :value="status"
            />
          </el-select>
        </div>

        <div class="filter-control">
          <span class="filter-label">
            精选
          </span>

          <el-select
            v-model="filterForm.is_featured"
            clearable
            placeholder="全部知识"
          >
            <el-option
              label="精选知识"
              :value="true"
            />

            <el-option
              label="普通知识"
              :value="false"
            />
          </el-select>
        </div>

        <div class="filter-actions">
          <el-button
            type="primary"
            :icon="Search"
            @click="handleSearch"
          >
            查询
          </el-button>

          <el-button
            :icon="Refresh"
            @click="handleReset"
          >
            重置
          </el-button>
        </div>
      </div>

      <!-- 工具栏 -->
      <div class="toolbar-section">
        <el-button
          type="primary"
          :icon="Plus"
          class="create-button"
          @click="openCreateDialog"
        >
          新增知识
        </el-button>

        <el-button
          :icon="Refresh"
          :loading="loading"
          class="refresh-button"
          @click="loadKnowledgeList"
        >
          刷新
        </el-button>
      </div>

      <!-- 知识列表 -->
      <div
        v-loading="loading"
        class="knowledge-content"
      >
        <div
          v-if="
            paginatedKnowledgeList.length
          "
          class="knowledge-grid"
        >
          <article
            v-for="item in paginatedKnowledgeList"
            :key="item.id"
            class="knowledge-card"
            :class="{
              featured: item.is_featured,
            }"
          >
            <div class="card-top">
              <div
                class="category-icon"
                :class="
                  getCategoryClass(
                    item.category,
                  )
                "
              >
                <el-icon>
                  <Collection />
                </el-icon>
              </div>

              <div class="card-tags">
                <span
                  class="status-badge"
                  :class="
                    getStatusClass(
                      item.status,
                    )
                  "
                >
                  {{ item.status }}
                </span>

                <span
                  v-if="item.is_featured"
                  class="featured-badge"
                >
                  <el-icon>
                    <Star />
                  </el-icon>

                  精选
                </span>
              </div>
            </div>

            <h3>
              {{ item.title }}
            </h3>

            <p class="knowledge-summary">
              {{
                item.summary ||
                item.content
              }}
            </p>

            <div class="tag-list">
              <span
                v-for="tag in (
                  item.tags || []
                ).slice(0, 4)"
                :key="tag"
                class="knowledge-tag"
              >
                {{ tag }}
              </span>

              <span
                v-if="
                  (item.tags || []).length > 4
                "
                class="more-tags"
              >
                +{{
                  item.tags.length - 4
                }}
              </span>
            </div>

            <div class="knowledge-meta">
              <span>
                {{
                  getProductName(
                    item.product_id,
                  )
                }}
              </span>

              <span>
                {{
                  item.source_type ||
                  '手动录入'
                }}
              </span>
            </div>

            <div class="card-footer">
              <div class="usage-info">
                <el-icon>
                  <Link />
                </el-icon>

                <span>
                  引用
                  {{ item.usage_count || 0 }}
                  次
                </span>
              </div>

              <div class="card-actions">
                <el-button
                  link
                  :icon="View"
                  @click="
                    openKnowledgeDetail(
                      item,
                    )
                  "
                >
                  查看
                </el-button>

                <el-button
                  type="success"
                  link
                  :icon="Link"
                  :loading="
                    usingKnowledgeId ===
                    item.id
                  "
                  @click="
                    handleUseKnowledge(
                      item,
                    )
                  "
                >
                  引用
                </el-button>

                <el-button
                  type="primary"
                  link
                  :icon="Edit"
                  @click="
                    openEditDialog(item)
                  "
                >
                  编辑
                </el-button>

                <el-button
                  type="danger"
                  link
                  :icon="Delete"
                  @click="
                    handleDelete(item)
                  "
                >
                  删除
                </el-button>
              </div>
            </div>
          </article>
        </div>

        <div
          v-else-if="!loading"
          class="empty-state"
        >
          <div class="empty-icon">
            <el-icon>
              <Collection />
            </el-icon>
          </div>

          <strong>
            暂无知识库内容
          </strong>

          <span>
            点击“新增知识”沉淀第一条业务经验
          </span>
        </div>
      </div>

      <!-- 分页 -->
      <div class="pagination-section">
        <span>
          共 {{ totalRecords }} 条
        </span>

        <el-pagination
          v-model:current-page="currentPage"
          v-model:page-size="pageSize"
          background
          layout="prev, pager, next, sizes"
          :page-sizes="[8, 16, 24]"
          :total="totalRecords"
          @size-change="changePageSize"
        />
      </div>
    </section>

    <!-- 新增和编辑弹窗 -->
    <el-dialog
      v-model="dialogVisible"
      :title="dialogTitle"
      width="760px"
      destroy-on-close
      class="knowledge-dialog"
      @closed="resetKnowledgeForm"
    >
      <el-form
        ref="formRef"
        :model="knowledgeForm"
        :rules="formRules"
        label-position="top"
      >
        <div class="form-grid">
          <el-form-item
            label="知识标题"
            prop="title"
            class="full-column"
          >
            <el-input
              v-model="knowledgeForm.title"
              maxlength="200"
              show-word-limit
              placeholder="请输入知识标题"
            />
          </el-form-item>

          <el-form-item
            label="知识分类"
            prop="category"
          >
            <el-select
              v-model="
                knowledgeForm.category
              "
              allow-create
              filterable
              style="width: 100%"
            >
              <el-option
                v-for="category in categoryOptions"
                :key="category"
                :label="category"
                :value="category"
              />
            </el-select>
          </el-form-item>

          <el-form-item label="关联商品">
            <el-select
              v-model="
                knowledgeForm.product_id
              "
              clearable
              filterable
              placeholder="不选择表示通用知识"
              style="width: 100%"
            >
              <el-option
                v-for="product in productList"
                :key="product.id"
                :label="
                  product.product_name ||
                  product.name
                "
                :value="product.id"
              />
            </el-select>
          </el-form-item>

          <el-form-item
            label="知识摘要"
            class="full-column"
          >
            <el-input
              v-model="
                knowledgeForm.summary
              "
              type="textarea"
              :rows="2"
              maxlength="500"
              show-word-limit
              resize="none"
              placeholder="简要概括这条知识的核心内容"
            />
          </el-form-item>

          <el-form-item
            label="知识正文"
            prop="content"
            class="full-column"
          >
            <el-input
              v-model="
                knowledgeForm.content
              "
              type="textarea"
              :rows="8"
              maxlength="30000"
              show-word-limit
              resize="vertical"
              placeholder="请输入完整知识内容、使用方法或经验总结"
            />
          </el-form-item>

          <el-form-item
