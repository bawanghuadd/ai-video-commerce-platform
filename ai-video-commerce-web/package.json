{
  "name": "ai-video-commerce-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint . && eslint . --cache",
    "format": "prettier --write --experimental-cli src/ scripts/",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "format:check": "node scripts/check-format.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run lint && npm run format:check && npm run check:architecture && npm run test:run && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.18.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.6.0",
    "oxlint": "~1.69.0",
    "prettier": "3.8.4",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
