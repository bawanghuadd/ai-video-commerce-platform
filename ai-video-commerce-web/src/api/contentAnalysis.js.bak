import request from '@/utils/request'


export function getContentAnalysisListApi(params) {
  return request({
    url: '/content-analyses',
    method: 'get',
    params,
  })
}

export function getContentAnalysisDetailApi(analysisId) {
  return request({
    url: `/content-analyses/${analysisId}`,
    method: 'get',
  })
}

export function createContentAnalysisApi(data) {
  return request({
    url: '/content-analyses',
    method: 'post',
    data,
  })
}

export function updateContentAnalysisApi(analysisId, data) {
  return request({
    url: `/content-analyses/${analysisId}`,
    method: 'put',
    data,
  })
}

export function deleteContentAnalysisApi(analysisId) {
  return request({
    url: `/content-analyses/${analysisId}`,
    method: 'delete',
  })
}